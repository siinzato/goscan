# Copie este arquivo para ".env" nesta mesma pasta e preencha os valores reais.
# O ".env" NUNCA é commitado (já está no .gitignore da raiz do projeto).

# Login do Tiny (o robô loga como você mesmo faria na tela)
TINY_EMAIL=
TINY_PASSWORD=
# Só mude se o Tiny usar outra URL de login pra sua conta
TINY_LOGIN_URL=https://erp.tiny.com.br/login

# Supabase do GoScan — pegue em supabase.com/dashboard > Project Settings > API
# ATENÇÃO: a service role key dá acesso TOTAL ao banco (ignora toda permissão/RLS).
# Nunca compartilhe, nunca commite, nunca cole em chat/print.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# UUID da empresa no GoScan (tabela "companies") — as OCs baixadas ficam
# associadas a esta empresa, igual a um upload manual feito por alguém dela.
GOSCAN_COMPANY_ID=

# "false" abre o navegador visível (útil pra ajustar seletores na 1ª vez).
# Deixe "true" pra rodar sozinho via Task Scheduler.
TINY_HEADLESS=true
