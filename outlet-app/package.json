{
  "name": "goscan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "node run-local.mjs",
    "dev:web": "vite",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "build": "tsc --noEmit && vite build",
    "preview": "node run-local.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "generate-seed-sql": "node scripts/generate-seed-sql.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@xenova/transformers": "^2.17.2",
    "fast-xml-parser": "^5.10.1",
    "lucide-static": "^1.25.0",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^26.1.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^0.20.1"
  }
}
