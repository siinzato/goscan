# ---- Frontend (Vite) — PÚBLICAS, ficam no bundle do navegador ----
# URL do projeto Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# anon/public key (Project Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=eyJ...

# ---- Backend (run-local.mjs) — PRIVADAS, nunca usam prefixo VITE_ ----
# Chave da API Anthropic (console.anthropic.com). Só é lida pelo servidor Node,
# nunca é enviada ao navegador. Sem ela, a leitura de prints usa apenas OCR local.
ANTHROPIC_API_KEY=sk-ant-...

# Porta do servidor de API local (padrão 8788 em dev, ver vite.config.ts)
API_PORT=8788

# ---- Catálogo Visual (download de imagens externas + Storage) ----
# Mesma URL do projeto acima (sem VITE_), só para o cliente admin do backend.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key (Project Settings > API > Project API keys > service_role).
# NUNCA prefixar com VITE_, nunca commitar, nunca expor ao navegador — só o
# processo Node deste servidor lê isso. Sem ela, a importação de planilha do
# Catálogo Visual ainda funciona (cria os produtos), mas não baixa as imagens.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
